{
  "categories": [
    {
      "title": "## 🚀 新功能",
      "labels": ["feature", "enhancement"]
    },
    {
      "title": "## 🐛 Bug 修复",
      "labels": ["bug", "fix"]
    },
    {
      "title": "## 📚 文档更新",
      "labels": ["documentation"]
    },
    {
      "title": "## ⚡ 性能优化",
      "labels": ["performance"]
    },
    {
      "title": "## 🔧 配置变更",
      "labels": ["configuration"]
    },
    {
      "title": "## 🧹 代码清理",
      "labels": ["refactor", "cleanup"]
    },
    {
      "title": "## ✅ 测试",
      "labels": ["test"]
    },
    {
      "title": "## 📦 依赖更新",
      "labels": ["dependencies"]
    }
  ],
  "ignore_labels": [
    "skip-changelog",
    "chore"
  ],
  "template": "${{CHANGELOG}}",
  "pr_template": "- ${{TITLE}} (#${{NUMBER}})",
  "empty_template": "No changes found."
}
